  id: dlg.informant.vendor
  entryNodeId: open
  nodes:
  - Id: open
    Speaker: Mother Tace
    Line: He buys here. Tuesdays, mostly, and he never haggles.
    Condition:
      RequireAll: []
      RequireNone: []
      RequireAny: []
    SetFlags: []
    NextNodeId: 
    Choices:
    - Text: What does he look like buying?
      NextNodeId: tell
      Condition:
        RequireAll: []
        RequireNone: []
        RequireAny: []
      SetFlags:
      - clue.vendor
    - Text: Say it or I make it a problem.
      NextNodeId: tell
      Condition:
        RequireAll: []
        RequireNone: []
        RequireAny: []
      SetFlags:
      - clue.vendor
      - clue.vendor.leaned
    - Text: Forget it.
      NextNodeId: off
      Condition:
        RequireAll: []
        RequireNone: []
        RequireAny: []
      SetFlags: []
  - Id: tell
    Speaker: Mother Tace
    Line: Head and a half over me and half as heavy. You'll know.
    Condition:
      RequireAll: []
      RequireNone: []
      RequireAny: []
    SetFlags: []
    NextNodeId: 
